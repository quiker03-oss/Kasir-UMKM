# =====================================================================
# DAFTAR ENVIRONMENT VARIABLES UNTUK VERCEL & PRODUCTION
# =====================================================================
# Lokasi pengisian di dashboard Vercel:
# 1. Buka dashboard Vercel -> Pilih Project Anda
# 2. Masuk ke tab "Settings" -> Klik menu "Environment Variables"
# 3. Masukkan Key dan Value berikut, lalu centang Production, Preview, Development
# =====================================================================

# 1. JWT_SECRET (Direkomendasikan diisi di Vercel)
# Kunci rahasia untuk menandatangani dan memverifikasi token sesi login pengguna.
# Jika tidak diisi, sistem menggunakan kunci default internal yang aman.
JWT_SECRET="kasir-umkm-super-secure-jwt-key-2026-production"

# 2. NODE_ENV (Wajib 'production' saat live)
NODE_ENV="production"

# 3. VITE_API_URL (Opsional)
# Kosongkan atau abaikan jika frontend & API berada di domain Vercel yang sama.
# Hanya diisi jika Anda memisahkan backend Express ke hosting lain (contoh: VPS/Render).
VITE_API_URL=""

# 4. GEMINI_API_KEY (Opsional)
# Diperlukan jika menggunakan integrasi fitur cerdas Gemini.
GEMINI_API_KEY=""

# 5. APP_URL (Opsional)
# URL publik aplikasi (contoh: https://kasir-umkm.vercel.app)
APP_URL=""
